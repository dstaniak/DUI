<?xml version="1.0" encoding="utf-8"?>
<TextureAtlas>
    <Texture>Images/atlas</Texture>
    <!-- Sprite origins and allocated cells are aligned to 4 px, with at least 4 px between sprites. -->
    <Regions>
        <Region name="slime-1" x="360" y="4" width="20" height="20" />
        <Region name="slime-2" x="384" y="4" width="20" height="20" />
        <Region name="bat-1" x="408" y="4" width="20" height="20" />
        <Region name="bat-2" x="432" y="4" width="20" height="20" />
        <Region name="bat-3" x="456" y="4" width="20" height="20" />
        <Region name="unfocused-button" x="260" y="104" width="65" height="14" />
        <Region name="focused-button-1" x="260" y="124" width="65" height="14" />
        <Region name="focused-button-2" x="260" y="144" width="65" height="14" />
        <Region name="panel-background" x="336" y="104" width="15" height="15" />
        <Region name="slider-off-background" x="360" y="104" width="11" height="10" />
        <Region name="slider-middle-background" x="376" y="104" width="3" height="3" />
        <Region name="slider-max-background" x="384" y="104" width="11" height="10" />
    </Regions>
    <Animations>
        <Animation name="slime-animation" delay="200">
            <Frame region="slime-1" />
            <Frame region="slime-2" />
        </Animation>
        <Animation name="bat-animation" delay="200">
            <Frame region="bat-1" />
            <Frame region="bat-2" />
            <Frame region="bat-1" />
            <Frame region="bat-3" />
        </Animation>
        <Animation name="focused-button-animation" delay="300">
            <Frame region="focused-button-1" />
            <Frame region="focused-button-2" />
        </Animation>		
    </Animations>
</TextureAtlas>
